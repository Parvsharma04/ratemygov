# Rate My Gov Environment Configuration

# 1. Database Connection
# PostgreSQL connection string via Cloudflare Hyperdrive or connection pooler (transaction mode)
DATABASE_URL=postgresql://user:password@pooler.example.com:6543/ratemygov?sslmode=require

# 2. Cryptographic Pepper for Duplicate Vote Protection
# 32+ random bytes as a hex string (generate with: openssl rand -hex 32).
# WARNING: Rotating this secret resets duplicate-vote prevention. Anyone holding this value
# together with the database could brute-force IP hashes, so treat it with strict confidentiality.
VOTER_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 3. Cloudflare Turnstile Anti-Abuse
# Server-side verification secret key
TURNSTILE_SECRET=0x4AAAAAAAx-xxxxxxxxxxxxxxxxxxxxxxxxxx
# Public site key for client-side widget rendering
PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAAx-xxxxxxxxxxxxxx

# 4. Snapshot Cron Task Authentication
# Shared secret for authenticating daily snapshot trigger requests
CRON_SECRET=replace_with_a_secure_random_string_for_cron

# 5. Geolocation Policy
# Options:
#   flag    - (default) record geolocation match metadata without rejecting any votes
#   country - reject votes if visitor is not detected as being in India
#   state   - reject votes if visitor detected state differs from selected state
GEO_MODE=flag

# 6. Response Thresholds
# Minimum responses required for a state before reliable percentages/map coloring are shown (default: 100)
MIN_RESPONSES=100
# Minimum responses required within a historical snapshot time window (default: 50)
MIN_WINDOW_RESPONSES=50

# 7. Load Testing / Verification Key
# ONLY for preview/staging environments to simulate synthetic load; NEVER configure in production.
LOAD_TEST_KEY=
