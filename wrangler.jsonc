{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ratemygov",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "GEO_MODE": "flag",
    "MIN_RESPONSES": "50"
  }
}
