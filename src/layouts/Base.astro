---
import mainCss from '../styles/main.css?raw';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Inline SVG favicon (satisfied/dissatisfied split) -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='7'%20fill='%230f172a'/%3E%3Crect%20x='5'%20y='9'%20width='9'%20height='14'%20rx='2'%20fill='%231d4ed8'/%3E%3Crect%20x='18'%20y='9'%20width='9'%20height='14'%20rx='2'%20fill='%23b91c1c'/%3E%3C/svg%3E"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Inline critical CSS -->
    <style is:inline set:html={mainCss} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-title">Rate My Gov</a>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav aria-label="Footer Navigation">
          <ul class="site-footer-nav">
            <li><a href="/trends">Trends</a></li>
            <li><a href="/methodology">Methodology</a></li>
            <li><a href="/privacy">Privacy</a></li>
          </ul>
        </nav>
        <p class="methodology-note">
          These results reflect voluntary online responses and are not representative of the state&apos;s population.
        </p>
      </div>
    </footer>
  </body>
</html>
